{
  "name": "wordshift-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "capture:play-store": "node scripts/tools/capturePlayStoreScreenshots.mjs",
    "compose:play-store": "node scripts/tools/composePlayStoreScreenshots.mjs",
    "compose:play-store-feature": "node scripts/tools/composePlayStoreFeatureGraphic.mjs",
    "validate:play-store": "node scripts/tools/validatePlayStoreAssets.mjs",
    "generate:play-store": "npm run capture:play-store && npm run compose:play-store && npm run compose:play-store-feature && npm run validate:play-store",
    "test:play-store-capture": "node --test scripts/tools/capturePlayStoreScreenshots.test.mjs",
    "test:play-store-assets": "node --test scripts/tools/playStoreAssets.test.mjs scripts/tools/playStoreFeatureGraphic.test.mjs",
    "generate:puzzles": "jest --config scripts/jest.config.js --no-coverage --testTimeout 900000",
    "generate:assets": "node scripts/tools/processAppIcon.mjs && node scripts/tools/generateAppIcons.mjs && node scripts/tools/generateNotificationIcon.mjs && node scripts/tools/generateSounds.mjs && node scripts/tools/generateWorldArt.mjs && node scripts/tools/generatePixelWorld.mjs && node scripts/tools/generateUiIcons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.12",
    "expo-application": "~56.0.3",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.21",
    "expo-constants": "~56.0.18",
    "expo-haptics": "~56.0.3",
    "expo-notifications": "~56.0.18",
    "expo-sharing": "~56.0.19",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.3",
    "expo-tracking-transparency": "~56.0.5",
    "expo-updates": "~56.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-purchases": "^10.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.0.1",
    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
