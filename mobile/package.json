{
  "name": "wordshift-mobile",
  "version": "1.3.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:puzzles": "node scripts/tools/generateGatedPuzzles.mjs",
