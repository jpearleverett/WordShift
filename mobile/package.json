    "audit:profanity": "node scripts/tools/purgeProfanity.mjs",
    "generate:vocabulary-policy": "node scripts/tools/buildVocabularyPolicy.mjs",
    "test:e2e": "playwright test",
    "audit:vocabulary": "node scripts/tools/auditVocabulary.mjs",
    "profile:android": "node scripts/tools/profileAndroid.mjs"
  },
  "dependencies": {
