    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "ts-jest": "^29.4.6",
    "typescript": "~6.0.3"
