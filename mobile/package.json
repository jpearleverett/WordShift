{
  "name": "wordshift-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:puzzles": "jest --config scripts/jest.config.js --no-coverage --testTimeout 900000",
    "generate:assets": "node scripts/tools/processAppIcon.mjs && node scripts/tools/generateSplash.mjs && node scripts/tools/generateNotificationIcon.mjs && node scripts/tools/generateSounds.mjs && node scripts/tools/generateWorldArt.mjs && node scripts/tools/generatePixelWorld.mjs && node scripts/tools/generateUiIcons.mjs && node scripts/tools/generateShopIcons.mjs && node scripts/tools/generateStoreIcons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.21",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.21",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.19",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.18",
    "expo-haptics": "~56.0.3",
    "expo-notifications": "~56.0.25",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.4",
    "expo-tracking-transparency": "~56.0.5",
    "expo-updates": "~56.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-purchases": "^10.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.0.1",
    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "ts-jest": "^29.4.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
