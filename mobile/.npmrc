# Expo SDK 57 / RN 0.86 pins one React 19 patch while some native modules
# peer-want a later one, a benign upstream peer over-specification. Relax strict peer
# resolution so `npm install`/`expo install` of native modules (react-native-purchases,
# react-native-google-mobile-ads, etc.) doesn't ERESOLVE. `npm ci` already tolerates
# this via the lockfile; this just makes fresh installs behave the same.
legacy-peer-deps=true
