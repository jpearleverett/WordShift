{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "WORDSHIFT_RELEASE_CHANNEL": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "WORDSHIFT_RELEASE_CHANNEL": "preview"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "WORDSHIFT_RELEASE_CHANNEL": "production"
      }
    },
    "internal-testing": {
      "distribution": "store",
      "channel": "internal-testing",
      "env": {
        "WORDSHIFT_RELEASE_CHANNEL": "internal-testing"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    },
    "internal-testing": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
